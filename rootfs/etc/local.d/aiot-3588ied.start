#!/bin/sh


echo 1 > /proc/sys/net/ipv4/ip_forward

iptables -t nat -A POSTROUTING -s 192.168.98.0/24 -o eth2 -j MASQUERADE
iptables -t nat -A POSTROUTING -s 192.168.98.0/24 -o eth3 -j MASQUERADE

/rkdev_arm64 &

i=0
while [ $i -lt 10 ]; do
	ip -4 -o addr show dev eth1 scope global 2>/dev/null | grep -q inet && break
	sleep 0.5
	i=$((i + 1))
done
/usr/sbin/aiot-3588ied-issue

sync
