#!/bin/sh

mode="$1"

kver=$(uname -r | sed 's/-.*//')

fmt_if() {
	local ifc="$1" label="$2"
	local a state
	a=$(ip -4 -o addr show dev "$ifc" scope global 2>/dev/null | awk '{split($4,x,"/"); print x[1]; exit}')
	if ip link show dev "$ifc" 2>/dev/null | grep -q "UP"; then
		state="UP"
	else
		state="DOWN"
	fi
	if [ -n "$a" ]; then
		printf '%s(%s): (%s) %s' "$ifc" "$label" "$state" "$a"
	else
		printf '%s(%s): (%s)' "$ifc" "$label" "$state"
	fi
}

line1=$(fmt_if eth0 WAN)
line2=$(fmt_if br0 LAN)

tmpf=$(mktemp)

if [ "$mode" = refresh ]; then printf '\0338\033[0J' > "$tmpf"; else printf '\0337' > "$tmpf"; fi

cat >> "$tmpf" <<'ART'

                            _ooOoo_
                           o8888888o
                           88" . "88
                           (| -_- |)
                           O/  =  /O
                        ____/`---'/____
                      .'  //|     |//  '.
                     /  //|||  :  |||//  /
                    /  _||||| -:- |||||-  /
                    |   | ///  -  /// |   |
                    | /_|  ''/---/''  |   |
                    /  .-/__  `-`  ___/-. /
                  ___`. .'  /--.--/  `. . __
               ."" '<  `.__/_<|>_/___.'  >'"".
              | | :  `- /;.` _ / /;.`/ - ` : | |
              /  / `-.   /_ __/ /__ _/   .-` /  /
         ======`-.____`.___ /_____/___.-`____.-'======
                            `=---='

         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
                           Buddha Bless
                  No Downtime, No Bugs, No Warnings

***************************************************************
  Welcome to RKdev System

  OS: Alpine Linux v3.24
  Kernel: KVER
  LINE1
  LINE2
  Default Account: root/root
  Documentation: https://github.com/yifengyou/aiot-3588ied

  Copyright (C) 2026 RKdev. All rights reserved.
***************************************************************

ART

sed -i -e "s|KVER|${kver}|" -e "s|LINE1|${line1}|" -e "s|LINE2|${line2}|" "$tmpf"

if cmp -s "$tmpf" /etc/issue 2>/dev/null; then
	rm -f "$tmpf"
	exit 0
fi
mv "$tmpf" /etc/issue
cp /etc/issue /etc/motd

if [ "$mode" = refresh ]; then
	for p in $(pidof getty); do
		tty=$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^tty/) print $i}')
		case "$tty" in
		tty[1-6]) kill "$p" 2>/dev/null ;;
		esac
	done
fi
