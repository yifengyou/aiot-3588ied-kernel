#!/bin/sh

mode="$1"

kver=$(uname -r | sed 's/-.*//')

fmt_if() {
	local ifc="$1" label="$2"
	local a state
	a=$(ip -4 -o addr show dev "$ifc" scope global 2>/dev/null | awk '{split($4,x,"/"); print x[1]; exit}')
	if ip link show dev "$ifc" 2>/dev/null | grep -q "UP"; then
		state="UP"
	else
		state="DOWN"
	fi
	if [ -n "$a" ]; then
		printf '%s(%s): (%s) %s' "$ifc" "$label" "$state" "$a"
	else
		printf '%s(%s): (%s)' "$ifc" "$label" "$state"
	fi
}

line1=$(fmt_if eth0 WAN)
line2=$(fmt_if eth1 LAN)

{
	if [ "$mode" = refresh ]; then printf '\0338\033[0J'; else printf '\0337'; fi
	printf '%s\n' ""
	printf '%s\n' "                            _ooOoo_"
	printf '%s\n' "                           o8888888o"
	printf '%s\n' "                           88\" . \"88"
	printf '%s\n' "                           (| -_- |)"
	printf '%s\n' "                           O\\  =  /O"
	printf '%s\n' "                        ____/\'---\\____"
	printf '%s\n' "                      .\'  \\\\|     |//  \'."
	printf '%s\n' "                     /  \\\\|||  :  |||//  \\"
	printf '%s\n' "                    /  _||||| -:- |||||-  \\"
	printf '%s\n' "                    |   | \\\\\\  -  /// |   |"
	printf '%s\n' "                    | \\_|  \'\'\\---/\'\'  |   |"
	printf '%s\n' "                    \\  .-\\__  \`-\'  ___/-. /"
	printf '%s\n' "                  ___\`. .\'  /--.--\\  \`. . __"
	printf '%s\n' "               .\"\" \'<  \`.___\\_<|>_/___.\'  >\'\"\"."
	printf '%s\n' "              | | :  \`- \\\`;.\` _ /\\\`;.\`/ - \` : | |"
	printf '%s\n' "              \\  \\ \`-.   \\_ __\\ /__ _/   .-\` /  /"
	printf '%s\n' "         ======\`-.____\`.___ \\_____/___.-\`____.-\'======"
	printf '%s\n' "                            \`=---=\'"
	printf '%s\n' ""
	printf '%s\n' "         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^"
	printf '%s\n' "                  Buddha Bless   No Downtime"
	printf '%s\n' "                   No Bugs       Amen"
	printf '%s\n' ""
	printf '%s\n' "***************************************************************"
	printf '%s\n' "  Welcome to RKdev System"
	printf '%s\n' ""
	printf '%s\n' "  OS: Alpine Linux (RK3588)"
	printf '%s\n' "  Kernel: ${kver}"
	printf '%s\n' "  ${line1}"
	printf '%s\n' "  ${line2}"
	printf '%s\n' "  Documentation: https://github.com/yifengyou/BDY_G98_RK3588"
	printf '%s\n' ""
	printf '%s\n' "  Default Account: root/root"
	printf '%s\n' "  Authorized access only. All activities are monitored."
	printf '%s\n' "***************************************************************"
	printf '%s\n' ""
} > /etc/issue.tmp

if cmp -s /etc/issue.tmp /etc/issue 2>/dev/null; then
	rm -f /etc/issue.tmp
	exit 0
fi
mv /etc/issue.tmp /etc/issue

if [ "$mode" = refresh ]; then
	for p in $(pidof getty); do
		tty=$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^tty/) print $i}')
		case "$tty" in
		tty[1-6]) kill "$p" 2>/dev/null ;;
		esac
	done
fi
